# Vidura World API — machine configuration template.
# Copy to .env next to run.sh / run.bat and edit for this machine.
# Every value is optional: the code defaults are portable and paper-safe.

# Where the SQLite database lives (default: <project>/var/app.db)
#VIDURA_DATABASE_PATH=/srv/vidura/data/app.db

# Root of the per-user secrets folders (default: <project>/customers)
# Layout: <root>/<username>/ containing kalshi .env + private key + .sam
#VIDURA_CUSTOMERS_ROOT=/srv/vidura/customers

# Python interpreter for the super_research engines (needs yfinance, pandas).
# Default: this API's own interpreter — install those deps into the venv, or
# point this at a separate install.
#VIDURA_SUPER_PYTHON=/usr/bin/python3

# OPTIONAL: the day-trade folder holding levels_watcher.py (level crosses +
# Tradier auto-trader source). Absent -> those panels show "not running".
#VIDURA_LEVELS_DIR=/srv/38trades/stock-trade

# SAFETY: paper-only is the default. Uncomment ONLY on a machine that is
# meant to place real-money orders.
#VIDURA_PAPER_ONLY=false

# Cloud profile (Render/Cloud Run auto-detects via PORT; force if needed)
#VIDURA_CLOUD_MODE=true

# Postgres instead of SQLite (cloud): overrides VIDURA_DATABASE_PATH
#VIDURA_DATABASE_URL_OVERRIDE=postgresql+psycopg://user:pw@host/db

# Lock the API behind a shared key (X-API-Key header) when exposed beyond
# localhost/LAN
#VIDURA_API_KEY=change-me

# Tradier desk defaults (see app/core/config.py for the full VIDURA_TRADIER_*
# and other knobs — every Settings field maps to VIDURA_<FIELD_NAME>)
#VIDURA_TRADIER_AUTO_TICKERS=SPY,QQQ,SPX
#VIDURA_TRADIER_AUTO_WINDOW_OPEN=08:30
#VIDURA_TRADIER_AUTO_WINDOW_CLOSE=09:30
